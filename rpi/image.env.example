# Copy to image.env (gitignored) and adjust. Leave a value empty to use the default.

# rpi3-64, rpi4-64 or rpi5-64
HAOS_BOARD=rpi3-64
# "latest" or a release tag such as 18.3
HAOS_VERSION=latest

# ethernet (recommended) or wifi
NET_INTERFACE=ethernet
WIFI_SSID=
WIFI_PSK=

# Static IPv4 in CIDR form, outside the router's DHCP pool. Empty = DHCP.
NET_ADDRESS=
NET_GATEWAY=
# Defaults to the gateway when empty
NET_DNS=

# Public key for HAOS host debug SSH on port 22222 (root). Empty = disabled.
SSH_AUTHORIZED_KEY=
