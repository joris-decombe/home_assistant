+    @staticmethod
+    def audioFileName(fileLocation):
+        """Where a raw save puts the audio: clip.ts -> clip.au"""
+        return os.path.splitext(fileLocation)[0] + ".au"
+
+    def _au_header(self, size):
+        # big-endian: magic, data offset, data size, encoding (1 = u-law,
+        # 27 = A-law), sample rate, channels
+        encoding = 1 if self.audio_payload_type == PayloadType.PCMU else 27
+        return struct.pack(
+            ">4s5I", b".snd", 24, size, encoding, int(self.audio_sample_rate), 1
+        )
