+def test_convert_save_raw_keeps_audio(tmp_path):
+    import asyncio
+    import struct
+    from rtp import PayloadType
+    from pytapo.media_stream.convert import Convert
+
+    c = Convert()
+    c.write(b"\x47" * 188, b"\xd5" * 160, PayloadType.PCMA, 8000)
+    c.write(b"\x47" * 188, b"\xd5" * 160)
+    asyncio.run(c.save(str(tmp_path / "clip.ts"), 1, "raw"))
+    assert (tmp_path / "clip.ts").read_bytes() == b"\x47" * 376
+    au = (tmp_path / "clip.au").read_bytes()
+    assert struct.unpack(">4s5I", au[:24]) == (b".snd", 24, 320, 27, 8000, 1)
+    assert au[24:] == b"\xd5" * 320
+
